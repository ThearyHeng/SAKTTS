# SAKTTS Server Port (defaults to 3800 to avoid conflicting with default 3000 node dev servers)
PORT=3800

# Super Admin Seed Credentials (Automatically initialized in production)
SUPER_ADMIN_EMAIL=thearyheng@gmail.com
SUPER_ADMIN_PASSWORD=001989@Thry
SUPER_ADMIN_NAME=Theary Heng

# Bakong Open API (NBC) — KHQR Auto-Verification & Auto-Approval
# Leave BAKONG_TOKEN unset to run Billing KHQR in local Sandbox verification mode.
# When BAKONG_TOKEN is set (and BAKONG_SANDBOX is not "true"), checkout uses live NBC Bakong MD5 checks.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=your_account@aba
BAKONG_MERCHANT_NAME=SAKTTS STUDIO
BAKONG_MERCHANT_CITY=Phnom Penh
# Optional for Merchant Tag 30 KHQR (leave blank for Individual Bakong Account Tag 29)
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=ABA Bank
BAKONG_SANDBOX=false
